---
/** The one persistent bar (DESIGN.md §8): the mark and case name on the left, a few plain controls on the right. */
import LangNav from './LangNav.astro';
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  homeHref: string;
  homeLabel: string;
  links: { href: string; label: string }[];
  tap?: boolean;
}
const { lang, homeHref, homeLabel, links, tap = false } = Astro.props;
const u = ui(lang);
---
<header class="bar">
  <a href={homeHref} aria-label={homeLabel}>
    <svg class="mark" viewBox="0 0 18 26" aria-hidden="true"><rect x="0.5" y="0.5" width="17" height="25" fill="#e8e2d4" /><rect x="6" y="3" width="6" height="2" fill="#17191c" /></svg>
    <span class="bar-label">{u.barCase}</span>
  </a>
  <nav aria-label={u.navSite}>
    {tap && <button class="toggle" type="button" data-toggle-tap aria-pressed="false"><span class="dot" aria-hidden="true"></span>{u.tap}</button>}
    {links.map((l) => <a href={l.href}><span class="bar-label">{l.label}</span></a>)}
  </nav>
  <LangNav lang={lang} compact label={u.language} />
</header>
