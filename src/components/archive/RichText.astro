---
/**
 * Renders one line of archive text with its redactions, white-outs and cross-references.
 * A cross-reference to a record the visitor has not unsealed shows as a black bar (archive.ts gates it).
 */
import { parseInline } from '../../content/inline';
import { byId } from '../../content/archive';
import { href, type Lang } from '../../i18n';
import { ui } from '../../i18n/ui';

interface Props {
  text: string;
  lang: Lang;
  /** The record this text belongs to: a lifted bar is remembered as record:width, the same in every language. */
  scope: string;
}
const { text, lang, scope } = Astro.props;
const u = ui(lang);
const segs = parseInline(text);
const requires = (id: string) => byId(id)?.requires.join(',') ?? '';
---
{segs.map((s) =>
  s.k === 'text' ? s.v
  : s.k === 'em' ? <em>{s.v}</em>
  : s.k === 'bar' && s.reveal ? <span class="liftable" data-lift={`${scope}:${s.w}`}><button class="lift" type="button"><span class="blackbar" style={`width: ${s.w}em`} aria-hidden="true"></span><span class="sr-only">{u.lift}</span></button><span class="lifted" hidden>{s.reveal}</span></span>
  : s.k === 'bar' ? <span class="redact"><span class="blackbar" style={`width: ${s.w}em`} aria-hidden="true"></span><span class="sr-only">{u.redacted}</span></span>
  : s.k === 'white' ? <span class="whiteout gap" style={`width: ${s.w}em`}><span class="sr-only">{u.forgotten}</span></span>
  : <span class="xref" data-requires={requires(s.to)} data-open={requires(s.to) === '' ? '' : undefined}><a class="xref-open" href={href(lang, `/archive/${s.to}/`)}>{s.v}</a><span class="xref-sealed"><span class="blackbar" style={`width: ${Math.max(4, s.v.length * (lang === 'zh' ? 1 : 0.45))}em`} aria-hidden="true"></span><span class="sr-only">{u.stillSealed}</span></span></span>
)}
