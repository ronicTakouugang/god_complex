---
/**
 * One record as a document from the fiction (DESIGN.md §4.1: a FILE sheet with a margin column
 * for annotations). Margin notes appear beside the sheet on desktop and after their paragraph on phones.
 */
import { Picture } from 'astro:assets';
import RichText from './RichText.astro';
import { byId, type ArchiveRecord, type Block } from '../../content/archive';
import tagusDrained from '../../assets/img/tagus-drained.png';
import evCctv from '../../assets/img/ev-cctv.png';
import evSwimbag from '../../assets/img/ev-swimbag.png';
import evNotebook from '../../assets/img/ev-notebook.png';
import evHarbourLog from '../../assets/img/ev-harbour-log.png';

interface Props {
  record: ArchiveRecord;
}
const { record: r } = Astro.props;
const images = { 'tagus-drained': tagusDrained, 'ev-cctv': evCctv, 'ev-swimbag': evSwimbag, 'ev-notebook': evNotebook, 'ev-harbour-log': evHarbourLog } as const;
const notesAfter = (i: number) => r.notes.filter((n) => n.after === i);
const blocks: Block[] = r.blocks;
const requireTitles = r.requires.map((id) => byId(id)?.title ?? id).join(' and ');
---
<div class="record-grid">
  <article class="doc" aria-labelledby="doc-title" data-record={r.id} data-requires={r.requires.join(',')}>
    <header class="doc-head">
      <h1 id="doc-title" style={`view-transition-name: rec-${r.id}`}>{r.title}</h1>
      <p class="stamp" aria-label={`Office stamp: ${r.stamp}`}>{r.stamp}</p>
    </header>

    <dl class="doc-meta tab">
      <div><dt>Reference</dt><dd>{r.ref}</dd></div>
      <div><dt>Type</dt><dd>{r.kind}</dd></div>
      <div><dt>From</dt><dd>{r.origin}</dd></div>
      <div><dt>Classification</dt><dd>{r.classification}</dd></div>
      <div><dt>Event</dt><dd><time datetime={r.event.iso}>{r.event.label}</time></dd></div>
      <div><dt>Filed</dt><dd><time datetime={r.filed.iso}>{r.filed.label}</time></dd></div>
      <div><dt>Entered into Case LETHE</dt><dd>{r.entered}</dd></div>
    </dl>
    {r.translated && <p class="doc-translated">{r.translated}</p>}

    {r.requires.length > 0 && (
      <>
        <p class="early" data-early hidden>You have opened this record out of order. Dr Okafor read it after {requireTitles}.</p>
        {/* Decided before the first paint, so the notice never pushes the document down after load. */}
        <script is:inline define:vars={{ requires: r.requires }}>
          try {
            var read = JSON.parse(localStorage.getItem('gc.archive') || '[]');
            if (!requires.every(function (id) { return read.indexOf(id) !== -1; })) document.currentScript.previousElementSibling.hidden = false;
          } catch (e) {}
        </script>
      </>
    )}

    <div class="doc-body">
      {blocks.map((b, i) => (
        <>
          {b.t === 'h' && <h2>{b.text}</h2>}
          {b.t === 'p' && <p class={b.voice === 'story' ? 'story' : undefined}><RichText text={b.text} /></p>}
          {b.t === 'fields' && (
            <dl class="fields">
              {b.rows.map(([k, v]) => <div><dt>{k}</dt><dd><RichText text={v} /></dd></div>)}
            </dl>
          )}
          {b.t === 'log' && (
            <figure class="log">
              <figcaption>{b.caption}</figcaption>
              <ol>
                {b.rows.map((row) => <li><span class="log-time tab">{row.time}</span><span class="log-text"><RichText text={row.text} /></span></li>)}
              </ol>
            </figure>
          )}
          {b.t === 'qa' && (
            <dl class="qa">
              {b.rows.map((row) => <div class={row.who.startsWith('R.') ? 'q' : 'a'}><dt>{row.who}</dt><dd><RichText text={row.text} /></dd></div>)}
            </dl>
          )}
          {b.t === 'table' && (
            <table class="doc-table">
              <caption>{b.caption}</caption>
              <thead><tr>{b.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>{b.rows.map((row) => <tr>{row.map((c) => <td><RichText text={c} /></td>)}</tr>)}</tbody>
            </table>
          )}
          {b.t === 'figure' && (
            <figure class="doc-figure">
              <Picture src={images[b.img]} alt={b.alt} widths={[480, 840]} sizes="(min-width: 1024px) 760px, 100vw" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" />
              <figcaption>{b.caption}</figcaption>
            </figure>
          )}
          {b.t === 'sign' && <p class="sign-off"><span class="sign-name">{b.name}</span><span class="sign-role">{b.role}</span></p>}
          {notesAfter(i).map((n) => (
            <p class="note note-inline"><span class="note-by">{n.by}</span><RichText text={n.text} /></p>
          ))}
        </>
      ))}
    </div>
  </article>

  <aside class="doc-margin" aria-label="Margin: notes and connections">
    {r.notes.map((n) => (
      <p class="note"><span class="note-by">{n.by}</span><RichText text={n.text} /></p>
    ))}
    <slot name="aside" />
  </aside>
</div>
