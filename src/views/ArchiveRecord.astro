---
/** One record of the archive, on its own page so Close and the browser's Back both return to the visitor's place. */
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import RecordView from '../components/archive/RecordView.astro';
import RichText from '../components/archive/RichText.astro';
import type { ArchiveRecord } from '../content/archive';
import { archive } from '../content/archive-i18n';
import { href, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  record: ArchiveRecord;
  lang: Lang;
}
const { record: r, lang } = Astro.props;
const u = ui(lang);
const { records, chronological, byId } = archive(lang);
const at = chronological.findIndex((x) => x.id === r.id);
const prev = chronological[at - 1];
const next = chronological[at + 1];
const unseals = records.filter((x) => x.requires.includes(r.id));
const closeHref = `${href(lang, '/archive/')}#${r.id}`;
const recHref = (id: string) => href(lang, `/archive/${id}/`);
const req = (x: ArchiveRecord) => x.requires.join(',');
---
<ArchiveLayout lang={lang} title={`${r.title} · ${r.ref} · The God Complex`} description={r.summary}
  links={[{ href: href(lang, '/archive/'), label: u.archive }, { href: closeHref, label: u.closeRecord }]}>
  <div class="record-page" data-close={closeHref}>
    <RecordView record={r} lang={lang}>
      <Fragment slot="aside">
      <section class="connections" aria-labelledby="conn-h">
        <h2 id="conn-h">{u.connections}</h2>
        <ul>
          {r.connections.map((c) => {
            const to = byId(c.to)!;
            return (
              <li class="conn" data-requires={req(to)} data-open={to.requires.length === 0 ? '' : undefined}>
                <a class="conn-open" href={recHref(to.id)}><span class="conn-title">{to.title}</span><span class="conn-ref tab">{to.ref}</span></a>
                <span class="conn-sealed"><span class="blackbar" style="width: 12em" aria-hidden="true"></span><span class="sr-only">{u.stillSealed}</span></span>
                <p class="conn-note"><RichText lang={lang} scope={r.id} text={c.note} /></p>
              </li>
            );
          })}
        </ul>
      </section>

      {unseals.length > 0 && (
        <section class="unsealed" data-unsealed hidden aria-labelledby="unsealed-h">
          <h2 id="unsealed-h">{u.unsealedBy}</h2>
          <ul>
            {unseals.map((x) => (
              <li data-requires={req(x)}><a href={recHref(x.id)}>{x.title}</a></li>
            ))}
          </ul>
        </section>
      )}
      </Fragment>
    </RecordView>

    <div class="after-doc">

      <nav class="chrono-nav" aria-label={u.chronology}>
        {prev ? (
          <span class="chrono-prev" data-requires={req(prev)} data-open={prev.requires.length === 0 ? '' : undefined}>
            <a class="xref-open" href={recHref(prev.id)}>{u.earlier} {prev.title}</a>
            <span class="xref-sealed">{u.earlier} <span class="blackbar" style="width: 9em" aria-hidden="true"></span><span class="sr-only">{u.sealedRecord}</span></span>
          </span>
        ) : <span></span>}
        {next ? (
          <span class="chrono-next" data-requires={req(next)} data-open={next.requires.length === 0 ? '' : undefined}>
            <a class="xref-open" href={recHref(next.id)}>{u.later} {next.title}</a>
            <span class="xref-sealed">{u.later} <span class="blackbar" style="width: 9em" aria-hidden="true"></span><span class="sr-only">{u.sealedRecord}</span></span>
          </span>
        ) : <span></span>}
      </nav>

      <a class="btn btn--bone close-btn" href={closeHref}>{u.closeRecord}</a>
    </div>
  </div>
</ArchiveLayout>
