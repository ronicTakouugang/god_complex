---
/** Not found: a missing page reads as a missing record, with clear ways back in every language. */
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import { OTHER_LANGS, LANG_INFO, href } from '../i18n';
import { ui } from '../i18n/ui';

const u = ui('en');
---
<ArchiveLayout lang="en" title={u.notFoundTitle} description={u.notFoundDesc}
  links={[{ href: '/', label: u.theFile }, { href: '/archive/', label: u.archive }]}>
  <div class="index-sheet">
    <div class="index-intro">
      <h1>{u.notFoundH1}</h1>
      <p class="index-lede">{u.notFoundLede}</p>
      <p class="fiction">{u.notFoundFiction}</p>
    </div>
    <p class="index-foot"><a href="/">{u.backToFile}</a> · <a href="/archive/">{u.openArchive}</a></p>
    {OTHER_LANGS.map((l) => (
      <p class="index-foot" lang={LANG_INFO[l].html}><a href={href(l, '/')}>{ui(l).backToFile}</a> · <a href={href(l, '/archive/')}>{ui(l).openArchive}</a></p>
    ))}
  </div>
</ArchiveLayout>
