---
/** One record of the archive, on its own page so Close and the browser's Back both return to the visitor's place. */
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import RecordView from '../../components/archive/RecordView.astro';
import RichText from '../../components/archive/RichText.astro';
import { records, chronological, byId, type ArchiveRecord } from '../../content/archive';

export function getStaticPaths() {
  return records.map((record) => ({ params: { id: record.id }, props: { record } }));
}

interface Props {
  record: ArchiveRecord;
}
const { record: r } = Astro.props;
const at = chronological.findIndex((x) => x.id === r.id);
const prev = chronological[at - 1];
const next = chronological[at + 1];
const unseals = records.filter((x) => x.requires.includes(r.id));
const closeHref = `/archive/#${r.id}`;
const req = (x: ArchiveRecord) => x.requires.join(',');
---
<ArchiveLayout title={`${r.title} · ${r.ref} · The God Complex`} description={r.summary}
  links={[{ href: '/archive/', label: 'Archive' }, { href: closeHref, label: 'Close record' }]}>
  <div class="record-page" data-close={closeHref} data-requires-titles={r.requires.map((id) => byId(id)?.title).join(' and ')}>
    <RecordView record={r}>
      <Fragment slot="aside">
      <section class="connections" aria-labelledby="conn-h">
        <h2 id="conn-h">Connections</h2>
        <ul>
          {r.connections.map((c) => {
            const to = byId(c.to)!;
            return (
              <li class="conn" data-requires={req(to)} data-open={to.requires.length === 0 ? '' : undefined}>
                <a class="conn-open" href={`/archive/${to.id}/`}><span class="conn-title">{to.title}</span><span class="conn-ref tab">{to.ref}</span></a>
                <span class="conn-sealed"><span class="blackbar" style="width: 12em" aria-hidden="true"></span><span class="sr-only">A record that is still sealed.</span></span>
                <p class="conn-note"><RichText text={c.note} /></p>
              </li>
            );
          })}
        </ul>
      </section>

      {unseals.length > 0 && (
        <section class="unsealed" data-unsealed hidden aria-labelledby="unsealed-h">
          <h2 id="unsealed-h">Unsealed by reading this</h2>
          <ul>
            {unseals.map((u) => (
              <li data-requires={req(u)}><a href={`/archive/${u.id}/`}>{u.title}</a></li>
            ))}
          </ul>
        </section>
      )}
      </Fragment>
    </RecordView>

    <div class="after-doc">

      <nav class="chrono-nav" aria-label="Chronology">
        {prev ? (
          <span class="chrono-prev" data-requires={req(prev)} data-open={prev.requires.length === 0 ? '' : undefined}>
            <a class="xref-open" href={`/archive/${prev.id}/`}>Earlier: {prev.title}</a>
            <span class="xref-sealed">Earlier: <span class="blackbar" style="width: 9em" aria-hidden="true"></span><span class="sr-only">a sealed record</span></span>
          </span>
        ) : <span></span>}
        {next ? (
          <span class="chrono-next" data-requires={req(next)} data-open={next.requires.length === 0 ? '' : undefined}>
            <a class="xref-open" href={`/archive/${next.id}/`}>Later: {next.title}</a>
            <span class="xref-sealed">Later: <span class="blackbar" style="width: 9em" aria-hidden="true"></span><span class="sr-only">a sealed record</span></span>
          </span>
        ) : <span></span>}
      </nav>

      <a class="btn btn--bone close-btn" href={closeHref}>Close record</a>
    </div>
  </div>
</ArchiveLayout>
