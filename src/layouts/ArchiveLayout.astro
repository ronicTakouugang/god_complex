---
/** Shell for the archive's pages: the same faces, tokens and bar as the homepage, and the fiction notice. */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/literata/opsz.css';
import '../styles/global.css';
import '../styles/archive.css';
import Bar from '../components/Bar.astro';
import LangNav from '../components/LangNav.astro';
import { LANG_INFO, href, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  links: { href: string; label: string }[];
}
const { lang, title, description, links } = Astro.props;
const u = ui(lang);
---
<!doctype html>
<html lang={LANG_INFO[lang].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17191c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <style is:inline>@view-transition { navigation: auto; } @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }</style>
  </head>
  <body class="archive-body">
    <a class="skip" href="#main">{u.skipRecord}</a>
    <Bar lang={lang} homeHref={href(lang, '/')} homeLabel={u.homeStart} links={links} />
    <main id="main" class="archive-main">
      <slot />
    </main>
    <footer class="archive-foot">
      <div class="foot-frame">
        <p>{u.archiveFiction}</p>
        <LangNav lang={lang} label={u.language} />
      </div>
    </footer>
    <script>
      import { initArchive } from '../scripts/archive';
      import { initPage } from '../scripts/page';
      initPage();
      initArchive();
    </script>
  </body>
</html>
